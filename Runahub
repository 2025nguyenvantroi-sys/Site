-- FUNCTIONS
local function clearContent()
    for _, v in ipairs(content:GetChildren()) do
        if v:IsA("GuiObject") and v ~= layout and v ~= padding then
            v:Destroy()
        end
    end
end

local function label(text)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -4, 0, 32)
    l.BackgroundColor3 = Color3.fromRGB(80, 50, 95)
    l.Text = text
    l.TextColor3 = white
    l.TextSize = 15
    l.Font = Enum.Font.GothamBold
    l.Parent = content

    Instance.new("UICorner", l).CornerRadius = UDim.new(0, 10)
    return l
end

local function button(text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -4, 0, 38)
    b.BackgroundColor3 = pink
    b.Text = text
    b.TextColor3 = white
    b.TextSize = 14
    b.Font = Enum.Font.GothamBold
    b.Parent = content

    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)

    b.MouseButton1Click:Connect(callback)
    return b
end

local function toggle(text, callback)
    local enabled = false

    local b = button(text .. " : OFF", function()
        enabled = not enabled
        b.Text = text .. (enabled and " : ON" or " : OFF")
        b.BackgroundColor3 = enabled
            and Color3.fromRGB(100, 220, 150)
            or pink

        callback(enabled)
    end)

    return b
end

local function slider(text, min, max, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -4, 0, 60)
    holder.BackgroundColor3 = Color3.fromRGB(80, 50, 95)
    holder.Parent = content

    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, -10, 0, 25)
    txt.Position = UDim2.fromOffset(5, 0)
    txt.BackgroundTransparency = 1
    txt.Text = text .. " : " .. min
    txt.TextColor3 = white
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 14
    txt.Parent = holder

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -20, 0, 12)
    bar.Position = UDim2.fromOffset(10, 35)
    bar.BackgroundColor3 = pink
    bar.Text = ""
    bar.Parent = holder

    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local value = min

    bar.MouseButton1Click:Connect(function()
        value = value + 1
        if value > max then value = min end

        txt.Text = text .. " : " .. value
        callback(value)
    end)
end

local tabs = {}

local function createTab(name)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(85, 35)
    b.BackgroundColor3 = pink
    b.Text = name
    b.TextColor3 = white
    b.TextSize = 13
    b.Font = Enum.Font.GothamBold
    b.Parent = tabBar

    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)

    tabs[name] = b

    b.MouseButton1Click:Connect(function()
        clearContent()

        for _, tab in pairs(tabs) do
            tab.BackgroundColor3 = pink
        end

        b.BackgroundColor3 = Color3.fromRGB(120, 220, 170)
    end)

    return b
end

